{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kura-spike-masonry",
  "version": "0.1.0",
  "identifier": "dev.kk6.kura.spike.masonry",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "masonry spike", "width": 1440, "height": 900 }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**/.data/**"] }
    }
  },
  "bundle": { "active": false }
}
