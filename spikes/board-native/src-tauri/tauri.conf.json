{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kura Native Spike",
  "version": "0.1.0",
  "identifier": "dev.kk6.kura.native-spike",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "人工ギャラリー・タスク0", "width": 640, "height": 540, "x": 80, "y": 140 },
      { "label": "board", "title": "人工ボード・タスク0", "width": 600, "height": 500, "x": 400, "y": 240 }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["../../../src-tauri/icons/icon.png"] }
}
