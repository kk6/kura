# 開発・テスト用に生成するダミーライブラリ
/dev-library/

# ライブラリの管理フォルダ（誤って作られた場合に備えて）
.kura/

# 画像はコミットしない
*.jpg
*.jpeg
*.png
*.webp
*.gif
!src-tauri/icons/**
# ドキュメントのスクリーンショット（npm run docs:screenshots で撮る）
!docs/images/*.jpg

# ビルド成果物・依存関係
node_modules/
dist/
src-tauri/target/
ml/.venv/
__pycache__/

# macOS
.DS_Store

# Playwright の出力
/test-results/
/test-results-baseline/
/playwright-report/

# Claude Code の作業用ファイル
/.claude/tmp/

# Claude Design への同期（/design-sync）の作業用ファイル
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
